# Copy this file to .dev.vars (gitignored) and fill in values.
#   cp .env.example .dev.vars
# Then: npm run local

# From @BotFather — required to chat with the bot on your Mac
TELEGRAM_BOT_TOKEN=123456:replace-me

# Optional for local run. Needed later when you deploy a public webhook.
TELEGRAM_WEBHOOK_SECRET=

# Hong Kong: Google Gemini / AI Studio is not available.
# Use OpenRouter instead (free models, works from HK):
#   1. Create a key at https://openrouter.ai/keys
#   2. Paste it below
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_MODEL=openrouter/free

# Optional alternatives (leave unused):
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama

# Leave empty on the first Mac run so you can send /whoami.
# Then paste your numeric id here and restart.
ADMIN_TELEGRAM_IDS=
PARENT_TELEGRAM_IDS=
HELPER_TELEGRAM_IDS=

TIMEZONE=Asia/Hong_Kong

# Cloudflare (GitLab CI deploy)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
