# Copy this file to .dev.vars (gitignored) and fill in values.
#   cp .env.example .dev.vars
# Then: npm run local

# From @BotFather — required to chat with the bot on your Mac
TELEGRAM_BOT_TOKEN=123456:replace-me

# Optional for local run. Needed later when you deploy a public webhook.
TELEGRAM_WEBHOOK_SECRET=

# Groq = the API company (https://console.groq.com). It is not a model name.
# Official vision model IDs: qwen/qwen3.6-27b or qwen/qwen3.8-27b
# https://console.groq.com/docs/vision
# 1. Create a key at https://console.groq.com/keys
# 2. Paste it on GROQ_API_KEY=
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=qwen/qwen3.6-27b

# Leave empty on the first Mac run so you can send /whoami.
# Then paste your numeric id here and restart.
ADMIN_TELEGRAM_IDS=
PARENT_TELEGRAM_IDS=
HELPER_TELEGRAM_IDS=

TIMEZONE=Asia/Hong_Kong

# Cloudflare (GitLab CI deploy)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
