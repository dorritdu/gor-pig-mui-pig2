# Copy this file to .dev.vars (gitignored) and fill in values.
#   cp .env.example .dev.vars
# Then: npm run local

# From @BotFather — required to chat with the bot on your Mac
TELEGRAM_BOT_TOKEN=123456:replace-me

# Optional for local run. Needed later when you deploy a public webhook.
TELEGRAM_WEBHOOK_SECRET=

# Kimi (Moonshot) reads notice photos. Hong Kong uses the international platform.
# 1. Open https://platform.kimi.ai  (not console.groq.com, not platform.kimi.com)
# 2. Sign in → API Keys → create a key
# 3. kimi-k3 can read photos; it unlocks after a small top-up (docs: minimum $1)
# Official vision models: kimi-k3, kimi-k2.6
# https://platform.kimi.ai/docs/guide/use-kimi-vision-model
LLM_PROVIDER=kimi
MOONSHOT_API_KEY=
LLM_MODEL=kimi-k3

# Leave empty on the first Mac run so you can send /whoami.
# Then paste your numeric id here and restart.
ADMIN_TELEGRAM_IDS=
PARENT_TELEGRAM_IDS=
HELPER_TELEGRAM_IDS=

TIMEZONE=Asia/Hong_Kong

# Cloudflare (GitLab CI deploy) — later, not needed for npm run local
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
