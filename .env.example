# Copy to .dev.vars for `wrangler dev`, or set as Wrangler / GitLab CI secrets.

# From @BotFather
TELEGRAM_BOT_TOKEN=123456:replace-me

# Random string, 1-256 chars. Also passed to Telegram setWebhook secret_token.
TELEGRAM_WEBHOOK_SECRET=replace-with-long-random-string

# From https://aistudio.google.com/apikey (free Gemini Flash)
GEMINI_API_KEY=replace-me

# Comma-separated Telegram numeric IDs. Use /whoami in the bot to get them.
ADMIN_TELEGRAM_IDS=111111111
PARENT_TELEGRAM_IDS=111111111,222222222
HELPER_TELEGRAM_IDS=333333333

TIMEZONE=Asia/Hong_Kong

# Cloudflare (GitLab CI deploy)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
