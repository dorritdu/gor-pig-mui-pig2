# Copy this file to .dev.vars (gitignored) and fill in values.
#   cp .env.example .dev.vars
# Then: npm run local

# From @BotFather — required to chat with the bot on your Mac
TELEGRAM_BOT_TOKEN=123456:replace-me

# Optional for local run. Needed later when you deploy a public webhook.
TELEGRAM_WEBHOOK_SECRET=

# Photos are read on this Mac by Ollama. Groq/Gemini sites are blocked from Hong Kong.
# Install: https://ollama.com/download
# Then: ollama pull qwen2.5vl
# Model page: https://ollama.com/library/qwen2.5vl
LLM_PROVIDER=ollama
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama
LLM_MODEL=qwen2.5vl

# Leave empty on the first Mac run so you can send /whoami.
# Then paste your numeric id here and restart.
ADMIN_TELEGRAM_IDS=
PARENT_TELEGRAM_IDS=
HELPER_TELEGRAM_IDS=

TIMEZONE=Asia/Hong_Kong

# Cloudflare (GitLab CI deploy) — later, not needed for npm run local
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
